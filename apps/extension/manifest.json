{
  "manifest_version": 3,
  "name": "Taproot — call-tree diff reviewer",
  "version": "0.1.0",
  "description": "Shows a pull request as a tree of the changed functions, callers before callees. Runs locally: no backend, no login, no telemetry.",

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html"],
      "matches": ["https://github.com/*"]
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
