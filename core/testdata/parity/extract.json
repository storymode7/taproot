      "source": "/// Parses input.\npub struct Parser;\n\nconst LIMIT: usize = 8; // max depth\n\nimpl Parser {\n    #[inline]\n    pub const fn new() -> Self {\n        Parser\n    }\n\n    pub fn parse(&self, s: &str) -> usize {\n        s.len().min(LIMIT)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn parses() {\n        assert_eq!(Parser::new().parse(\"ab\"), 2);\n    }\n}\n",
